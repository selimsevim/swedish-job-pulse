# Environment variables for the public Railway app (app/server.py).
# Set these as Railway service variables (Project → Variables). They are read
# only by the server and are NEVER exposed to the browser.
#
# Local dev:  export them in your shell, or `set -a; source env.example; set +a`
# after filling in real values (do NOT commit real values).

# Base URL of the Nebius /cv-fit endpoint — WITHOUT the trailing /cv-fit path.
# The server appends /cv-fit itself.
NEBIUS_CV_FIT_URL=https://your-endpoint.nebius.cloud

# Bearer token for the Nebius endpoint.
NEBIUS_CV_FIT_TOKEN=replace-with-your-token

# Optional: upstream request timeout in seconds (default 60).
# NEBIUS_CV_FIT_TIMEOUT=60
